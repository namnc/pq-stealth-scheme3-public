      "expect": {
        "spending_pk": "034f355bdcb7cc0af728ef3cceb9615d90684bb5b2ca5f859ab0f0b704075871aa",
        "ek": "",
        "ek_length": 1184,
        "deterministic": true,
        "tracking_key_is_the_dz_seed": "e582b7d75e6c80b05ae392a1fc9f7153b12390fd99930368cc67a768baebc8a01cdacb8740c0b87c4a379575f187b367cbfa3b300bf591b109f79816e9cbe8f0",
